{
  "name": "placement-platform-backend",
  "version": "1.0.0",
  "description": "AI-Powered Placement Management Platform Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest --runInBand tests/integration"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.12.1",
    "pg": "^8.11.0",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.0.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testTimeout": 20000
  },
  "engines": {
    "node": ">=20"
  }
}
