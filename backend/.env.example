# --- Required ---
DATABASE_URL=postgresql://admin:secret@localhost:5432/placement_db
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---
PORT=3000
# Set to true for managed Postgres that requires TLS (Neon, Supabase, Render)
DATABASE_SSL=false
# Keep true; set false only if your provider uses a self-signed certificate
DATABASE_SSL_VERIFY=true
JWT_EXPIRES_IN=24h

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Without a key, matching uses the deterministic rule-based engine only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# Without REDIS_URL the app runs uncached
REDIS_URL=redis://localhost:6379
MATCH_CACHE_TTL_SECONDS=86400

AI_CONFIDENCE_THRESHOLD=0.6
# Set to false to skip auto-seeding demo accounts and jobs
SEED_DEMO_DATA=true
